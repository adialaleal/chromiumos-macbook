// XKB Symbols for Apple MacBook Keyboard layout under ChromeOS
// Remaps Command (Super) and Option (Alt) keys for intuitive ChromeOS operation

default partial xkb_symbols "macbook" {
    name[Group1]= "Apple MacBook ChromeOS Layout";

    // Swap Command and Alt if desired, or keep Command as Super/Search
    key <LALT> { [ Alt_L, Meta_L ] };
    key <RALT> { [ Alt_R, Meta_R ] };
    key <LWIN> { [ Super_L ] };
    key <RWIN> { [ Super_R ] };

    // Function keys default to media keys (F1-F12 when Fn held down)
    key <FK01> { [ XF86MonBrightnessDown, F1 ] };
    key <FK02> { [ XF86MonBrightnessUp,   F2 ] };
    key <FK03> { [ XF86LaunchA,           F3 ] };
    key <FK04> { [ XF86LaunchB,           F4 ] };
    key <FK05> { [ XF86KbdBrightnessDown, F5 ] };
    key <FK06> { [ XF86KbdBrightnessUp,   F6 ] };
    key <FK07> { [ XF86AudioPrev,         F7 ] };
    key <FK08> { [ XF86AudioPlay,         F8 ] };
    key <FK09> { [ XF86AudioNext,         F9 ] };
    key <FK10> { [ XF86AudioMute,         F10 ] };
    key <FK11> { [ XF86AudioLowerVolume,  F11 ] };
    key <FK12> { [ XF86AudioRaiseVolume,  F12 ] };
};
